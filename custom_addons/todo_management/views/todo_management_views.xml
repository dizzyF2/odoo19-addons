<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="todo_task_view_list" model="ir.ui.view">
        <field name="name">todo.task.view.list</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="description"/>
                <field name="assign_to"/>
                <field name="due_date"/>
                <field name="status" />
                <field name="is_overdue" invisible="1" />
            </list>
        </field>
    </record>

    <record id="todo_task_view_form" model="ir.ui.view">
        <field name="name">todo.task.view.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                        <button 
                            string="In Progress" 
                            name="action_in_progress" 
                            type="object" 
                            class="oe_highlight"
                            invisible="status != 'new'"
                        />
                        <button 
                            string="Completed" 
                            name="action_completed" 
                            type="object" 
                            class="oe_highlight"
                            invisible="status != 'in_progress'"
                        />
                        <button 
                            string="Reset to New" 
                            name="action_new" 
                            type="object"
                            invisible="status == 'new'"
                        />
                        <field name="status" widget="statusbar"/>
                    </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="assign_to"/>
                        <field name="due_date"/>
                        <field name="active" invisible="True" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="todo_task_view_search" model="ir.ui.view">
        <field name="name">todo.task.view.search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assign_to"/>

                <filter name="group_by_assign_to" string="Assign to" context="{'group_by': 'assign_to'}" />
                <filter name="group_by_state" string="Status" context="{'group_by': 'status'}" />
                <filter name="group_by_due_date" string="Due Date" context="{'group_by': 'due_date'}" />

                <filter name="status_new" string="status: New" domain="[('status', '=', 'new')]"/>
                <filter name="status_in_progress" string="status: in Progress" domain="[('status', '=', 'in_progress')]" />
                <filter name="status_completed" string="status: Completed" domain="[('status', '=', 'completed')]" />
            </search>
        </field>
    </record>

    <record id="tasks_action" model="ir.actions.act_window">
        <field name="name">Todo Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="ie">
                Add your first task
            </p>
        </field>
    </record>

    <record id="todo_closed_server_action" model="ir.actions.server">
        <field name="name">Closed</field>
        <field name="model_id" ref="model_todo_task" />
        <field name="binding_model_id" ref="model_todo_task" />
        <field name="state">code</field>
        <field name="code">
            action = records.action_closed()
        </field>
    </record>

    <record id="check_due_date_cron" model="ir.cron">
        <field name="name">todo: checking due date</field>
        <field name="model_id" ref="model_todo_task" />
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
